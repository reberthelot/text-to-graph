# Copy to .env and fill in CAMPUSAI_API_KEY (never commit .env).
CAMPUSAI_API_KEY=
CAMPUSAI_API_URL=https://api.campusai.compute.dtu.dk/v1
CAMPUSAI_MODEL=cai
CAMPUSAI_EMBED_MODEL=cai-embedding

# Retrieval. On the DTU network, the best measured setting is
# ENABLE_DENSE=true, DEFAULT_MODE=hybrid, DEFAULT_TOP_K=10 (see README).
DEFAULT_MODE=sparse
DEFAULT_TOP_K=5
ENABLE_DENSE=false
SPARSE_CHAR_NGRAMS=true
EMBED_CACHE_DIR=data/embed_cache

# Generation
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
MAX_CONTEXT_CHARS=12000

# Evaluation frontend
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_TIMEOUT_SECONDS=90
RAG_EVAL_CONCURRENCY=5

LOG_LEVEL=INFO
